#compdef cocotero

_cocotero() {
  local -a commands keys cats
  commands=(add open browse-cluster cite read cluster pdf rm clean sync reading login)
  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi
  case "$words[2]" in
    reading)
      if (( CURRENT == 3 )); then
        _values 'action' list current add progress done drop
      else
        keys=(${(f)"$(print -l "${COCOTERO_LIB:-$HOME/cocotero/library}"/bib/*.bib(:r:t) 2>/dev/null)"})
        _describe 'key' keys
      fi
      ;;
    open|pdf|rm|cite|read)
      keys=(${(f)"$(print -l "${COCOTERO_LIB:-$HOME/cocotero/library}"/bib/*.bib(:r:t) 2>/dev/null)"})
      _describe 'key' keys
      ;;
    browse-cluster|cluster)
      cats=(${(f)"$(grep -h '^category' "${COCOTERO_LIB:-$HOME/cocotero/library}"/bib/*.bib 2>/dev/null | sed 's/.*= {//; s/}.*//' | tr ',' ' ')"})
      _describe 'cluster' cats
      ;;
  esac
}

_cocotero "$@"
